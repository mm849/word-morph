{
    "name": "chat-ai-webapp",
    "version": "1.0.0",
    "description": "A web application for interacting with chat AI",
    "main": "server.js",
    "scripts": {
        "start": "node server.js",
        "dev": "nodemon server.js",
        "client": "cd client && npm start",
        "dev:full": "concurrently \"npm run dev\" \"npm run client\""
    },
    "dependencies": {
        "cors": "^2.8.5",
        "dotenv": "^16.3.1",
        "express": "^4.18.2",
        "openai": "^4.96.2"
    },
    "devDependencies": {
        "concurrently": "^8.2.1",
        "nodemon": "^3.0.1"
    }
}
